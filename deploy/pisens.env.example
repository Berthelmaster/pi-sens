# Settings for the pisens service, read by systemd from /etc/pisens/pisens.env.
# deploy/install.sh copies this file there on the first install and never
# overwrites it afterwards.
#
# Every line below is commented out and shows the default. Uncomment a line
# and change the value to override it, then run: sudo systemctl restart pisens
#
# Lines are KEY=value with no "export" and no spaces around "=".

# HTTP listen address. ":8080" listens on every interface; use
# "127.0.0.1:8080" to keep the dashboard local to the Pi. A port below 1024
# needs CAP_NET_BIND_SERVICE, see the comment in pisens.service.
#PISENS_LISTEN=:8080

# How often the collectors are sampled, as a Go duration (500ms, 2s, 1m).
#PISENS_INTERVAL=2s

# Directory for persistent data. The service always uses /var/lib/pisens: it
# passes --data-dir, which wins over this variable, and it is the only
# writable directory under the service's hardening. Only listed for
# completeness.
#PISENS_DATA_DIR=/var/lib/pisens

# How often the buffered samples are written to the history database
# (pisens.db in the data directory). A longer interval means fewer writes to
# the SD card but more samples lost if the Pi loses power.
#PISENS_HISTORY_INTERVAL=10s

# How long the history database keeps raw samples and the 1 minute and 15
# minute rollups. Go durations, so use hours for days: 7 days is 168h.
#PISENS_HISTORY_RAW_RETENTION=24h
#PISENS_HISTORY_1M_RETENTION=168h
#PISENS_HISTORY_15M_RETENTION=2160h

# YAML file of alert rules that replaces the built-in rules completely; see
# "Alerts" in the README for the format. Off unless set. The file must be
# readable by the pisens user, e.g. root-owned with mode 0644.
#PISENS_ALERTS_FILE=/etc/pisens/alerts.yaml

# Alert notifications. Both are off unless set; set one or both. The URLs
# often work as passwords, which is why install.sh makes this file readable
# by root only.
# URL that gets every firing and resolved alert POSTed as JSON.
#PISENS_NOTIFY_WEBHOOK=https://example.com/pisens-hook
# ntfy topic URL, e.g. https://ntfy.sh/some-long-random-topic. Credentials for
# a protected topic go in the URL: https://user:pass@ntfy.example.com/topic
#PISENS_NOTIFY_NTFY=
# Shortest time between two firing notifications of the same alert, so a
# flapping alert does not flood you. 0 turns it off.
#PISENS_NOTIFY_COOLDOWN=15m

# systemd services whose state the dashboard shows, comma separated. ".service"
# is added to names without it. The services section always counts active and
# failed services and lists the failed ones; this only adds the named ones.
#PISENS_WATCH_SERVICES=ssh,pisens

# How much of the top processes' command lines the dashboard and API show:
#   off       only the process name
#   redacted  the command line with the values of secret looking arguments
#             (--password, --token, --api-key, --secret, -p<password>,
#             key=value where the key contains pass, token, secret or key,
#             and passwords in URLs) replaced by ***
#   full      the command line as it is; anyone who can reach the dashboard
#             sees every argument, passwords included
#PISENS_PROCESS_CMDLINE=redacted

# Network interfaces the network section leaves out, comma separated. Each is
# a name, or a prefix when it ends in *. The default skips loopback and the
# virtual interfaces Docker creates, so container traffic is not counted twice.
# Setting this replaces the default list, so keep the entries you still want
# skipped, e.g. for podman, libvirt and Tailscale:
#   PISENS_NET_SKIP=lo,veth*,docker*,br-*,cni*,podman*,virbr*,tailscale0
#PISENS_NET_SKIP=lo,veth*,docker*,br-*

# Electricity price per kWh, so the energy section shows what the Pi's energy
# use costs today and this month. Off unless set. Use a dot for decimals.
# The currency is only shown next to the cost, any text works.
#PISENS_ENERGY_PRICE=2.45
#PISENS_ENERGY_CURRENCY=DKK

# Network quality: every interval pisens pings the default gateway and these
# internet hosts (IPv4 addresses or host names, comma separated) with a burst
# of 5 pings and reports latency, jitter and packet loss. It uses unprivileged
# ICMP, or times a TCP connect where the kernel does not allow that. Set
# PISENS_NETQ=off to send no pings at all. An empty target list keeps the
# default; use --netq-targets= on the command line to ping only the gateway.
#PISENS_NETQ=on
#PISENS_NETQ_TARGETS=1.1.1.1,8.8.8.8
#PISENS_NETQ_INTERVAL=10s
# Every round also looks up this host name at the first nameserver in
# /etc/resolv.conf and reports how long that took. An empty value keeps the
# default; use --netq-dns-name= on the command line to skip the lookups.
#PISENS_NETQ_DNS_NAME=example.com

# Serve metrics for Prometheus at /metrics. Set to false to turn it off.
#PISENS_PROMETHEUS=true

# HTTP basic auth for the dashboard and API. Off unless both are set; pisens
# refuses to start with only one. /api/health always stays open. Create the
# hash with: /usr/local/bin/pisens hash-password
# Keep the hash in single quotes, it contains "$" signs. Basic auth is not
# encrypted: beyond the LAN, put pisens behind a reverse proxy with TLS.
#PISENS_AUTH_USER=admin
#PISENS_AUTH_PASSWORD_HASH='$2a$10$...'
