# Settings for the pisens service, read by systemd from /etc/pisens/pisens.env.
# deploy/install.sh copies this file there on the first install and never
# overwrites it afterwards.
#
# Every line below is commented out and shows the default. Uncomment a line
# and change the value to override it, then run: sudo systemctl restart pisens
#
# Lines are KEY=value with no "export" and no spaces around "=".

# HTTP listen address. ":8080" listens on every interface; use
# "127.0.0.1:8080" to keep the dashboard local to the Pi. A port below 1024
# needs CAP_NET_BIND_SERVICE, see the comment in pisens.service.
#PISENS_LISTEN=:8080

# How often the collectors are sampled, as a Go duration (500ms, 2s, 1m).
#PISENS_INTERVAL=2s

# Directory for persistent data. The service always uses /var/lib/pisens: it
# passes --data-dir, which wins over this variable, and it is the only
# writable directory under the service's hardening. Only listed for
# completeness.
#PISENS_DATA_DIR=/var/lib/pisens

# Alert notifications. Both are off unless set; set one or both. The URLs
# often work as passwords, which is why install.sh makes this file readable
# by root only.
# URL that gets every firing and resolved alert POSTed as JSON.
#PISENS_NOTIFY_WEBHOOK=https://example.com/pisens-hook
# ntfy topic URL, e.g. https://ntfy.sh/some-long-random-topic. Credentials for
# a protected topic go in the URL: https://user:pass@ntfy.example.com/topic
#PISENS_NOTIFY_NTFY=
# Shortest time between two firing notifications of the same alert, so a
# flapping alert does not flood you. 0 turns it off.
#PISENS_NOTIFY_COOLDOWN=15m

# systemd services whose state the dashboard shows, comma separated. ".service"
# is added to names without it. The services section always counts active and
# failed services and lists the failed ones; this only adds the named ones.
#PISENS_WATCH_SERVICES=ssh,pisens

# Serve metrics for Prometheus at /metrics. Set to false to turn it off.
#PISENS_PROMETHEUS=true
